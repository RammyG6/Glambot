# Runtime data (footage, generated files, secrets) — never committed
inbox/
project/
overlays/
!overlays/.gitkeep
soundtracks/
!soundtracks/.gitkeep
*.sqlite
*.sqlite3
*.log
.glambot/
.env
credentials.json
token.json
# Local FTP-server export — machine-specific, contains a user password hash
FTP_FX6_Config.xml
*_Config.xml

# Python
.venv/
# Embedded Python 3.11 runtime for the Phantom camera bridge (built locally /
# at packaging time; see camera_bridge/README.md). ~370 MB, machine-specific.
camera_bridge/runtime/
__pycache__/
*.pyc
*.egg-info/

# macOS
.DS_Store

# Windows standalone app build output — GlambotSetup.exe embeds this
# machine's live secrets (see windows_app/installer.iss); never commit it.
windows_app/build/
windows_app/dist/
windows_app/vendor/*.exe
windows_app/*.exe
windows_app/glambotlogo.ico

# macOS packaged app build output — same reasoning as windows_app/ above.
mac_app/build/
mac_app/dist/
mac_app/vendor/ffprobe
mac_app/glambotlogo.icns

# Local backups
*.bak
