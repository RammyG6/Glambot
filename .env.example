# Copy this file to .env and fill in real values. Never commit .env.

# --- Google Drive (OAuth desktop-app flow) ---
# 1. Create a Google Cloud project, enable the "Google Drive API".
# 2. Create an OAuth Client ID of type "Desktop app", download the JSON,
#    save it in the project root as credentials.json.
# 3. Create (or reuse) a Drive folder to receive approved deliveries and
#    paste its folder ID below (the long id in the folder's URL).
DRIVE_FOLDER_ID=

# --- SMTP email (e.g. Google Workspace on g6moco.com) ---
# Use an app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@g6moco.com
SMTP_PASS=
FROM_ADDR=you@g6moco.com

# --- App ---
# Camera FTP auto-import (replaces running FileZilla Server) is configured
# entirely in the app: open the "FTP import" tab. No .env vars for it.
INBOX_DIR=inbox
HOST=127.0.0.1
PORT=5000

# Socket to listen on. Leave as-is for local-only use. Set to 0.0.0.0 to serve
# guest downloads / iPad control over the LAN (see WINDOWS_SETUP.md).
BIND_HOST=127.0.0.1

# Signed-cookie secret. Leave blank to auto-generate one under .glambot/secret.
FLASK_SECRET=

# --- LAN / offline guest delivery + iPad control ---
# Operator PIN required from any non-loopback device once set. Blank = no PIN
# (fine while BIND_HOST stays on loopback).
GLAMBOT_PIN=
# Optional override for the base URL baked into guest QR codes, e.g.
# http://192.168.8.1:5000 . Blank = auto-detect this PC's LAN IP.
PUBLIC_BASE_URL=
# SSID/password for the "Join Wi-Fi" QR on the delivery photo. Blank = guests
# are assumed to already be on the network (only the download QR is shown).
LAN_SSID=
LAN_PASSWORD=
